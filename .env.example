# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001
# These are Supabase public browser settings. Do not prefix any server secret
# with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API (apps/api/.env)
PORT=3001
WEB_ORIGIN=http://localhost:3002
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexo
SUPABASE_URL=
# Public Supabase key for server-side Supabase calls when needed. The browser
# receives the separate NEXT_PUBLIC_SUPABASE_ANON_KEY above.
SUPABASE_ANON_KEY=
# Never expose these values to apps/web or an environment named NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
# Optional: only required by Supabase projects that still issue legacy HS256
# access tokens. Modern ES256 tokens are verified with the public JWKS exposed
# by SUPABASE_URL.
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional: https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
SUPABASE_ESSAY_BUCKET=essay-images
# Only valid in NODE_ENV=development or test. It is never a production fallback.
DEMO_AUTH_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.2
AI_PROVIDER_TIMEOUT_MS=60000
AI_EVALUATIONS_PER_DAY=3
ESSAY_RUBRIC_VERSION=enem-2026-simulation-v3
# Required by /admin/exam-imports. Keep this value only in apps/api/.env or
# deployment secrets; the browser asks an administrator for it per session.
ADMIN_IMPORT_KEY=troque-por-uma-chave-administrativa-longa
# Optional public base URL used by persisted question image crops.
EXAM_ASSET_PUBLIC_URL=http://localhost:3001/exam-assets
# Optional location for unapproved local previews (defaults to tmp/exam-imports).
EXAM_IMPORT_TMP_DIR=
# Optional absolute path to the local Tesseract executable when it is not in
# PATH (the default Windows installer path is detected automatically).
TESSERACT_CMD=
# `por` is preferred; `eng` is sufficient for number + A-E answer-key OCR.
TESSERACT_LANGUAGE=por
