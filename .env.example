# Web (apps/web/.env.local)
NEXT_PUBLIC_API_URL=http://localhost:3001
# These are Supabase public browser settings. Do not prefix any server secret
# with NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=
# Public Supabase key used server-side only for allowlisted signup. The browser
# receives the separate NEXT_PUBLIC_SUPABASE_ANON_KEY above.
SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# API (apps/api/.env)
PORT=3001
WEB_ORIGIN=http://localhost:3002
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexo
SUPABASE_URL=
# Never expose these values to apps/web or an environment named NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=
SUPABASE_JWT_AUDIENCE=authenticated
# Optional: https://<project-ref>.supabase.co/auth/v1
SUPABASE_JWT_ISSUER=
SUPABASE_ESSAY_BUCKET=essay-images
# Comma-separated beta allowlist. Empty blocks all new production signups.
ALLOWED_SIGNUP_EMAILS=
# Only valid in NODE_ENV=development or test. It is never a production fallback.
DEMO_AUTH_ENABLED=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TEMPERATURE=0.2
AI_PROVIDER_TIMEOUT_MS=60000
AI_EVALUATIONS_PER_DAY=3
ESSAY_RUBRIC_VERSION=enem-2026-simulation-v3
