generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model UserProfile {
  id           String        @id
  displayName  String?
  createdAt    DateTime      @default(now())
  quizSessions QuizSession[]
  essays       Essay[]
}

model Exam {
  id            String     @id @default(cuid())
  year          Int
  day           Int
  color         String
  language      String?
  version       String
  sourceUrl     String?
  sourceVersion String?
  questions     Question[]

  @@unique([year, day, color, language, version])
}

model Question {
  id              String            @id @default(cuid())
  examId          String
  exam            Exam              @relation(fields: [examId], references: [id])
  number          Int
  area            String
  statement       String
  explanation     String?
  imageUrl        String?
  isCancelled     Boolean           @default(false)
  correctOptionId String
  options         QuestionOption[]
  assets          QuestionAsset[]
  attempts        QuestionAttempt[]

  @@index([examId, area])
  @@unique([examId, number])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  content    String

  @@unique([questionId, label])
}

model QuestionAsset {
  id           String   @id @default(cuid())
  questionId   String
  question     Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  url          String
  storagePath  String?
  placement    String
  optionLabel  String?
  displayOrder Int      @default(0)
  mimeType     String
  altText      String
  sourcePage   Int?
  sourceCrop   Json?
  sourceHash   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([questionId, placement, optionLabel, displayOrder])
}

model QuizSession {
  id        String            @id @default(cuid())
  userId    String?
  user      UserProfile?      @relation(fields: [userId], references: [id])
  examId    String?
  questionIds Json?
  createdAt DateTime          @default(now())
  attempts  QuestionAttempt[]

  @@index([userId, createdAt])
}

model QuestionAttempt {
  id         String      @id @default(cuid())
  sessionId  String
  session    QuizSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  questionId String
  question   Question    @relation(fields: [questionId], references: [id])
  optionId   String
  correct    Boolean
  answeredAt DateTime    @default(now())

  @@unique([sessionId, questionId])
}

model Essay {
  id            String           @id @default(cuid())
  userId        String
  user          UserProfile      @relation(fields: [userId], references: [id])
  topic         String
  transcription String?
  transcriptionResult Json?
  confirmedText String?
  consentAt     DateTime?
  status        String           @default("draft")
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  evaluatedAt   DateTime?
  images        EssayImage[]
  evaluation    EssayEvaluation?

  @@index([userId, createdAt])
}

model EssayImage {
  id          String   @id @default(cuid())
  essayId     String
  essay       Essay    @relation(fields: [essayId], references: [id], onDelete: Cascade)
  storagePath String
  originalStoragePath String?
  mimeType    String
  size        Int
  page        Int      @default(1)
  createdAt   DateTime @default(now())
}

model EssayEvaluation {
  id         String   @id @default(cuid())
  essayId    String   @unique
  essay      Essay    @relation(fields: [essayId], references: [id], onDelete: Cascade)
  totalScore Int
  payload    Json
  provider   String
  createdAt  DateTime @default(now())
}
